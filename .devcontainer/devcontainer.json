{
  "name": "Labs Streamlit - POSTECH",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "pip install --no-cache-dir -r Labs-streamlit/requirements.txt",
  "forwardPorts": [8501, 5000, 8000],
  "portsAttributes": {
    "8501": { "label": "Streamlit", "onAutoForward": "openBrowser" },
    "5000": { "label": "MLflow UI", "onAutoForward": "openBrowser" },
    "8000": { "label": "HTTP (labs)", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  },
  "hostRequirements": { "cpus": 2 }
}
